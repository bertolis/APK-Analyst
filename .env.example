# Copy to .env and fill in. .env is git-ignored — never commit your real key.
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — embeddings for the Step 4 RAG knowledge base.
# Free key: https://dashboard.voyageai.com/
VOYAGE_API_KEY=pa-...

# --- Optional: knowledge-base directories (sensible repo-local defaults) ---
# The RAG base is built from public OWASP standards (MASVS + MASWE + MASTG),
# fetched at build time. These two vars are only for OPTIONAL extra sources of
# your own — point them at folders of .md files to supplement the OWASP base:
#   • PLAYBOOK = how to find/confirm an issue (supplements MASWE+MASTG)
#   • RULEBOOK = standards/controls to cite (supplements MASVS)
# Both default to the repo's ./playbook/ and ./rulebook/ folders (empty). ~ expands.
# APK_ANALYST_PLAYBOOK_DIR=~/path/to/your/notes
# APK_ANALYST_RULEBOOK_DIR=~/path/to/your/standards
#
# Where the built index + fetched OWASP cache are stored. Defaults to
# apk_analyst/data/. Override to keep the index outside the repo, etc.
# APK_ANALYST_DATA_DIR=~/path/to/apk-analyst-data

# Abort a scan if decompiled output exceeds this many MB (default 2048) —
# guards the local disk against an oversized or malicious APK.
APK_ANALYST_MAX_WORKSPACE_MB=2048
